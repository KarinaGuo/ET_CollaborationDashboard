reg_monit_survey_results_mat_GT$Date <- factor(reg_monit_survey_results_mat_GT$`Myrtle rust worst score`, levels = c(0:5))
mod_worst <- brm(
formula = bf(Myrtle_rust_worst_score ~ Date_index + (1 | Site / UID)),
data = reg_monit_survey_results_mat_GT,
family = hurdle_cumulative(link = "logit")
)
raw_numbers <- as.numeric(as.character(reg_monit_survey_results_mat_GT$Myrtle_rust_worst_score))
reg_monit_survey_results_mat_GT$Myrtle_rust_worst_score_pos <- factor(
raw_numbers + 1,
ordered = TRUE,
levels = c(1:6)
)
# 2. Fit the strict model (proportional odds assumed) on just the positive data
mod_ord_strict <- brm(
formula = Myrtle_rust_worst_score_pos ~ Date_index + (1 | Site / UID),
data = reg_monit_survey_results_mat_GT,
family = cumulative(link = "logit")
)
# 3. Fit the relaxed model (category-specific effects) on just the positive data
mod_ord_relaxed <- brm(
formula = Myrtle_rust_worst_score_pos ~ cs(Date_index) + (1 | Site / UID),
data = reg_monit_survey_results_mat_GT,
family = cumulative(link = "logit")
)
