snps_gr <- GRanges(
seqnames = input_SNPs$chr,
ranges = IRanges(start = input_SNPs$pos, end = input_SNPs$pos)
)
get_nearest_feature <- function(query_gr, gff_file, prefix) {
gff <- import(gff_file, format = "gff3")
## Is it in a gene?
overlaps <- findOverlaps(query_gr, gff)
is_in_feature <- rep(FALSE, length(query_gr))
overlap_types <- rep("None", length(query_gr))
if (length(overlaps) > 0) {
types_hit <- as.character(gff$type[subjectHits(overlaps)])
split_types <- split(types_hit, queryHits(overlaps))
collapsed_types <- sapply(split_types, function(x) paste(unique(x), collapse = ","))
matched_idx <- as.integer(names(collapsed_types))
is_in_feature[matched_idx] <- TRUE
overlap_types[matched_idx] <- collapsed_types
}
## Distance to closest gene
features <- gff[gff$type %in% c("CDS")]
nearest_hits <- distanceToNearest(query_gr, features)
feature_ids <- if (!is.null(features$ID)) {
features$ID[subjectHits(nearest_hits)]
} else if (!is.null(features$Name)) {
features$Name[subjectHits(nearest_hits)]
} else {
features$gene_id[subjectHits(nearest_hits)]
}
distances <- mcols(nearest_hits)$distance
res <- data.frame(
in_any_feature = is_in_feature,
overlapping_types = overlap_types,
nearest_gene = feature_ids,
distance = distances,
stringsAsFactors = FALSE
)
colnames(res) <- paste0(c("in_any_feature_", "overlapping_types_", "nearest_gene_", "distance_"), prefix)
return(res)
}
hapA_results <- get_nearest_feature(snps_gr, "data/nlr_hapA.gff3", "hapA")
final_table <- bind_cols(input_SNPs, hapA_results)
